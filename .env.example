# Local multilingual model. Change it only together with --reset:
# a collection refuses a different embedding model.
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

RAW_DIR=data/raw
PROCESSED_DIR=data/processed
CHROMA_DIR=data/chroma
COLLECTION_NAME=olist_ecommerce

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
BATCH_SIZE=500

ENABLE_REVIEW_DOCUMENTS=true
ENABLE_AGGREGATE_DOCUMENTS=true

RANDOM_SEED=42
LOG_LEVEL=INFO
DATASET_VERSION=brazilian-ecommerce-olist
