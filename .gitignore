.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
*.egg-info/
.coverage
htmlcov/

.env

# Raw Kaggle extracts are large and redistributable only from the source.
data/raw/*
!data/raw/README.md

# Regenerated by the ingestion pipeline.
data/processed/*
!data/processed/.gitkeep

# Local vector index.
data/chroma/*
!data/chroma/.gitkeep
